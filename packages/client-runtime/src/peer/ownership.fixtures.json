      "call": {"state": "accepted", "task": "vl9", "session": "claude:b", "environment": "bob-laptop", "email": "bob@acme.test", "paths": ["src/payments/fees.ts"]},
      "session": {"id": "claude:b", "environment": "bob-laptop", "email": "bob@acme.test", "task": null},
