      "person": "bob@acme.test",
      "path": "migrations/0001.sql",
      "expect": {"ask": null}
    },
    {
      "name": "the owner of the most specific pattern is asked",
      "scenario": "The most specific path owner decides",
      "map": {"areas": {}, "paths": {"src/payments/**": "ana@acme.test", "src/payments/refunds/**": "bob@acme.test"}, "decide": ["src/payments/**"]},
      "person": "ana@acme.test",
      "path": "src/payments/refunds/api.ts",
      "expect": {"ask": "bob@acme.test"}
    },
    {
      "name": "a path outside every pattern needs no call",
      "scenario": "An edit in an owner-decides path waits for the owner's call",
      "map": {"areas": {}, "paths": {"src/payments/**": "ana@acme.test"}, "decide": ["src/payments/**"]},
      "person": "bob@acme.test",
      "path": "src/ui/button.tsx",
      "expect": {"ask": null}
    },
    {
      "name": "an owner who left is still the one asked, and their leads decide",
      "scenario": "People who leave stop owning",
      "map": {"areas": {}, "paths": {"src/payments/**": "cyril@acme.test"}, "decide": ["src/payments/**"]},
      "person": "bob@acme.test",
      "path": "src/payments/fees.ts",
      "expect": {"ask": "cyril@acme.test"}
    }
  ],
  "coverage": [
    {
      "name": "an accepted call covers the paths it names for a session on its task",
